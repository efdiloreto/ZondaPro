import Base from '../layouts/Base.astro';
import TarjetaModulo from '../components/TarjetaModulo.astro';
import Captura from '../components/Captura.astro';
import iconoEdificio from '../assets/edificio.png';
import iconoCubierta from '../assets/cubierta-aislada.png';
import iconoCartel from '../assets/cartel.png';

// El base no termina en barra y las rutas vienen con la inicial: se
// concatenan directo para que respeten /ZondaPro/.
const rutaDe = (ruta: string) => `${import.meta.env.BASE_URL}${ruta}`;
---

<Base titulo="Inicio">
	<section class="hero">
		<div class="contenedor">
			<h1>Cargas de viento según CIRSOC 102-2025</h1>
			<p class="bajada">
				Zonda es software libre de escritorio para el cálculo de cargas y presiones de viento en
				estructuras según el reglamento argentino <strong>CIRSOC 102-2025</strong>.
			</p>
			<div class="acciones">
				<a class="boton boton-accion" href={rutaDe('/descarga/')}>Descargar</a>
				<a class="boton boton-dialogo" href={rutaDe('/caracteristicas/')}>Ver características</a>
			</div>
		</div>
	</section>

	<section class="modulos">
		<div class="contenedor">
			<h2>Elegí la tipología de tu estructura</h2>
			<p class="texto-suave">Tres módulos, el mismo motor de cálculo reglamentario.</p>
			<div class="grilla">
				<TarjetaModulo
					titulo="Edificios"
					texto="Cerrados y parcialmente cerrados, cubiertas planas, a un agua y a dos aguas, con o sin parapetos."
					icono={iconoEdificio.src}
					enlace={rutaDe('/edificio/')}
					textoEnlace="Ver el módulo"
				/>
				<TarjetaModulo
					titulo="Cubiertas aisladas"
					texto="A un agua, dos aguas y abovedadas, abiertas o con obstrucciones."
					icono={iconoCubierta.src}
					enlace={rutaDe('/cubierta-aislada/')}
					textoEnlace="Ver el módulo"
				/>
				<TarjetaModulo
					titulo="Carteles y muros"
					texto="Sobre terreno o elevados, con soporte estructural."
					icono={iconoCartel.src}
					enlace={rutaDe('/cartel/')}
					textoEnlace="Ver el módulo"
				/>
			</div>
		</div>
	</section>

	<section class="destacados">
		<div class="contenedor">
			<h2>Lo que trae</h2>
			<div class="grilla">
				<div class="tarjeta destacado">
					<h3>29 ciudades precargadas</h3>
					<p>
						Elegís la ciudad y Zonda completa la velocidad básica del viento según el mapa
						isoceraúnico del Reglamento, con la altitud y la topografía del sitio.
					</p>
				</div>
				<div class="tarjeta destacado">
					<h3>Visor 3D con el detalle del cálculo</h3>
					<p>
						Tocás una zona y el panel muestra el desglose completo: factores, coeficientes y la
						referencia del Reglamento que se aplicó.
					</p>
				</div>
				<div class="tarjeta destacado">
					<h3>Reporte a PDF</h3>
					<p>
						El reporte completo con la referencia de cada valor, listo para el pliego y
						exportable a PDF.
					</p>
				</div>
				<div class="tarjeta destacado">
					<h3>Cerramiento verificado</h3>
					<p>
						Ingresás las aberturas y el programa clasifica el edificio y define la presión
						interna, con las condiciones del Reglamento en pantalla.
					</p>
				</div>
			</div>
			<p class="ver-mas">
				<a href={rutaDe('/caracteristicas/')}>Ver todas las características →</a>
			</p>
		</div>
	</section>

	<section class="capturas">
		<div class="contenedor">
			<h2>La aplicación</h2>
			<div class="grilla-capturas">
				<Captura titulo="Selección de módulo" />
				<Captura titulo="Módulo Edificios" />
			</div>
		</div>
	</section>
</Base>

<style>
	.hero {
		background-color: var(--fondo-panel);
		border-bottom: 1px solid var(--linea);
		padding: 72px 0 64px;
	}

	.hero .contenedor {
		text-align: center;
	}

	.hero h1 {
		font-size: clamp(30px, 5vw, 44px);
	}

	.hero p {
		font-size: 18px;
		color: var(--texto-suave);
	}

	/* Los botones centrados: el flex del bloque de acciones los alinea. */
	.acciones {
		display: flex;
		justify-content: center;
		gap: 12px;
		flex-wrap: wrap;
		margin-top: 24px;
	}

	section + section {
		margin-top: 56px;
	}

	section h2 {
		font-size: 24px;
	}

	.grilla {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 16px;
	}

	.grilla-capturas {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 20px;
	}

	.destacado {
		padding: 20px;
	}

	.destacado h3 {
		font-size: 17px;
		margin-bottom: 6px;
	}

	.destacado p {
		margin: 0;
		font-size: 14px;
		color: var(--texto-suave);
	}

	.ver-mas {
		margin-top: 20px;
		text-align: right;
		font-family: var(--fuente-titulos);
		font-size: 16px;
	}
</style>
