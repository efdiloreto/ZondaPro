import Base from '../layouts/Base.astro';
import Captura from '../components/Captura.astro';
---

<Base
	titulo="Módulo Edificio"
	descripcion="Presiones de viento en edificios: cubiertas planas, a un agua y a dos aguas, cerramiento verificado, SPRFV por método direccional y C&R."
>
	<section class="encabezado-seccion contenedor">
		<h1>Módulo Edificio</h1>
		<p class="texto-suave">
			Presiones de viento en edificios cerrados y parcialmente cerrados, con cubierta plana, a
			un agua o a dos aguas.
		</p>
	</section>

	<section class="contenedor seccion">
		<h2>La geometría</h2>
		<ul>
			<li>Tres tipos de cubierta: plana, a un agua y a dos aguas.</li>
			<li>Con o sin parapeto y alero en voladizo, con sus alturas propias.</li>
			<li>Elevación sobre el terreno para pisos bajo el nivel 0.</li>
			<li>Alturas personalizadas para evaluar presiones a cotas específicas.</li>
		</ul>
	</section>

	<section class="contenedor seccion">
		<h2>El cerramiento</h2>
		<ul>
			<li>
				Verificación automática: ingresás las aberturas de las cuatro paredes y la cubierta, y
				el programa clasifica el edificio (cerrado, parcialmente cerrado o abierto) con las
				condiciones del Reglamento verificadas en pantalla.
			</li>
			<li>Presión interna ±GCpi según el cerramiento, con reducción opcional por volumen interno.</li>
		</ul>
	</section>

	<section class="contenedor seccion">
		<h2>Lo que calcula</h2>
		<ul>
			<li>
				<strong>SPRFV por método direccional:</strong> presiones de paredes (barlovento,
				sotavento y laterales) y cubierta por dirección de viento, con alero y parapeto.
			</li>
			<li>
				<strong>Componentes y revestimientos:</strong> zonas de pared y cubierta según el área
				efectiva de cada componente, con presión mínima incluida.
			</li>
			<li>Parapeto según el Art. 5.6, con el área efectiva de viento del parapeto.</li>
		</ul>
	</section>

	<section class="contenedor seccion">
		<h2>La aplicación</h2>
		<Captura titulo="Módulo Edificio" />
	</section>
</Base>

<style>
	.encabezado-seccion {
		padding-top: 40px;
	}

	.encabezado-seccion h1 {
		font-size: 34px;
		margin-bottom: 4px;
	}

	.seccion {
		margin-top: 40px;
		padding-top: 24px;
		border-top: 1px solid var(--borde);
	}

	.seccion h2 {
		font-size: 22px;
	}

	ul {
		margin: 0 0 1em;
		padding-left: 20px;
	}

	li {
		margin-bottom: 6px;
	}
</style>
