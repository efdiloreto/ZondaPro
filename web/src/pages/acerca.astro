import Base from '../layouts/Base.astro';
---

<Base
	titulo="Acerca de Zonda — Software libre de cargas de viento"
	descripcion="Zonda es software libre de cálculo de cargas de viento según CIRSOC 102-2025, la norma argentina basada en ASCE 7, distribuido bajo licencia GPLv3."
>
	<section class="contenedor seccion">
		<h2>El proyecto</h2>
		<p>
			Zonda nació para resolver el cálculo de cargas de viento del Reglamento Argentino <strong>CIRSOC 102-2025</strong> de forma rápida y confiable: de la geometría de la
			estructura a la memoria de cálculo lista para el pliego, sin planillas ni
			interpolaciones a mano. Es software libre: podés usarlo, estudiarlo, modificarlo y
			compartirlo.
		</p>
	</section>

	<section class="contenedor seccion">
		<h2>Autores</h2>
		<p>Copyright © 2018–2026</p>
		<ul>
			<li>Eduardo Di Loreto &lt;<a href="mailto:efdiloreto@gmail.com">efdiloreto@gmail.com</a>&gt;</li>
			<li>Natalia Alvarado &lt;<a href="mailto:mnaa85@gmail.com">mnaa85@gmail.com</a>&gt;</li>
		</ul>
	</section>

	<section class="contenedor seccion">
		<h2>Licencia</h2>
