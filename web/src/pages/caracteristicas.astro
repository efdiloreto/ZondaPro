import Base from '../layouts/Base.astro';
import Captura from '../components/Captura.astro';

// Lo que tienen los tres módulos. Las features de cada tipología viven
// en su propia página: edificio, cartel y cubierta aislada.

// El base no termina en barra y las rutas vienen con la inicial: se
// concatenan directo para que respeten /ZondaPro/.
const ruta = (ruta: string) => `${import.meta.env.BASE_URL}${ruta}`;

const secciones = [
	{
		titulo: 'El viento de diseño',
		items: [
			'Velocidad básica precargada para 29 ciudades argentinas, con los mapas isoceraúnicos del Reglamento según la categoría de riesgo (Figuras 1.5-1A, 1.5-1B y 1.5-1C).',
			'Factor de exposición Kz según el terreno: categorías B, C y D (Art. 1.7).',
			'Factor topográfico Kzt para loma, escarpa y colina (Figura 1.8-1), con la verificación automática de si corresponde aplicarlo.',
			'Factor de altitud Ke según la elevación del sitio (Art. 1.12).',
			'Factor de ráfaga G = 0,85 simplificado, o calculado para estructuras rígidas y flexibles con su frecuencia natural (Art. 1.9).',
			'Factor de direccionalidad Kd (Art. 1.7) y presión de velocidad q a cada altura.',
		],
	},
	{
		titulo: 'Resultados con referencias',
		items: [
			'Cada valor de tabla y cada zona del visor cita la figura, tabla o artículo del Reglamento que le dio origen.',
			'Máximo empuje y máxima succión resaltados en las tablas.',
			'Tarjetas de resumen con la velocidad, los factores y las presiones extremas con su ubicación.',
		],
	},
	{
		titulo: 'Visor 3D',
		items: [
			'Mapeo de presiones por colores sobre la estructura, con flechas y etiquetas de valor.',
			'Selección de una zona al tocarla: el panel de detalle muestra el desglose del cálculo (q, Kz, Kzt, Ke, Cp, G, GCpi) y su referencia.',
			'Medición de distancias entre vértices con regla graduada.',
			'Vistas de cámara fijas, perspectiva u ortográfica, zoom y captura de imagen.',
		],
	},
];
---

<Base
	titulo="Características"
	descripcion="Lo que tienen todos los módulos de Zonda: el viento de diseño, resultados con referencias del Reglamento, visor 3D, reporte a PDF y unidades a elegir."
>
	<section class="encabezado-seccion contenedor">
		<h1>Características</h1>
		<p class="texto-suave">
			Lo que tienen los tres módulos. Cada tipología suma lo propio en su página:
			<a href={ruta('/edificio/')}>Edificio</a>,
			<a href={ruta('/cartel/')}>Cartel</a> y
			<a href={ruta('/cubierta-aislada/')}>Cubierta aislada</a>.
		</p>
	</section>

	{
		secciones.map((seccion) => (
			<section class="contenedor seccion">
				<h2>{seccion.titulo}</h2>
				<ul>
					{seccion.items.map((item) => <li set:html={item} />)}
				</ul>
			</section>
		))
	}

	<section class="contenedor seccion">
		<h2>Reporte</h2>
		<ul>
			<li>Exportación del reporte a PDF, con elección de papel y orientación.</li>
			<li>Notas del Reglamento incluidas: mínimos de diseño, parapetos y consideraciones de cada figura.</li>
		</ul>
		<Captura titulo="Reporte y exportación a PDF" />
	</section>

	<section class="contenedor seccion">
		<h2>Unidades a elegir</h2>
		<ul>
			<li>Presión en N/m², kN/m² o kG/m²; fuerza en N, kN o kG.</li>
			<li>La unidad elegida se aplica al instante en las tablas, el visor 3D y el PDF.</li>
		</ul>
	</section>
</Base>

<style>
	.encabezado-seccion {
		padding-top: 40px;
	}

	.encabezado-seccion h1 {
		font-size: 34px;
		margin-bottom: 4px;
	}

	.seccion {
		margin-top: 40px;
		padding-top: 24px;
		border-top: 1px solid var(--borde);
	}

	.seccion h2 {
		font-size: 22px;
	}

	ul {
		margin: 0 0 1em;
		padding-left: 20px;
	}

	li {
		margin-bottom: 6px;
	}
</style>
