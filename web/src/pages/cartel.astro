import Base from '../layouts/Base.astro';
import Captura from '../components/Captura.astro';
---

<Base
	titulo="Módulo Cartel"
	descripcion="Fuerzas de viento sobre carteles y muros según la Figura 4.4-1: casos A, B y C, doble cara, aberturas y esquina de retorno."
>
	<section class="encabezado-seccion contenedor">
		<h1>Módulo Cartel</h1>
		<p class="texto-suave">Fuerzas de viento sobre carteles y muros, sobre terreno o elevados (Figura 4.4-1).</p>
	</section>

	<section class="contenedor seccion">
		<h2>La geometría</h2>
		<ul>
			<li>Cartel sobre terreno o elevado, con sus alturas, ancho y profundidad.</li>
			<li>Cartel de doble cara con los factores de reducción correspondientes.</li>
			<li>Esquina de retorno Lr con su reducción.</li>
		</ul>
	</section>

	<section class="contenedor seccion">
		<h2>Lo que calcula</h2>
		<ul>
			<li>
				<strong>Tres casos de fuerza</strong> (A, B y C), con las regiones horizontales del
				Caso C cuando corresponde, y el caso que gobierna el diseño indicado.
			</li>
			<li>Reducción por aberturas del cartel: relación entre área sólida y área bruta.</li>
			<li>Fuerza total por caso y fuerza mínima reglamentaria aplicada automáticamente.</li>
		</ul>
	</section>

	<section class="contenedor seccion">
		<h2>La aplicación</h2>
		<Captura titulo="Módulo Cartel" />
	</section>
</Base>

<style>
	.encabezado-seccion {
		padding-top: 40px;
	}

	.encabezado-seccion h1 {
		font-size: 34px;
		margin-bottom: 4px;
	}

	.seccion {
		margin-top: 40px;
		padding-top: 24px;
		border-top: 1px solid var(--borde);
	}

	.seccion h2 {
		font-size: 22px;
	}

	ul {
		margin: 0 0 1em;
		padding-left: 20px;
	}

	li {
		margin-bottom: 6px;
	}
</style>
