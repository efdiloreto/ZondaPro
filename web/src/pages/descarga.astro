import Base from '../layouts/Base.astro';
import iconoWindows from '../assets/windows.svg';
import iconoApple from '../assets/apple.svg';
import iconoLinux from '../assets/linux.svg';

// Los instaladores de la última release, uno por sistema operativo.
const instaladores = [
	{ sistema: 'Windows', icono: iconoWindows, archivo: '.msi' },
	{ sistema: 'macOS', icono: iconoApple, archivo: '.dmg' },
	{ sistema: 'Linux', icono: iconoLinux, archivo: '.flatpak' },
];
---

<Base
	titulo="Descarga"
	descripcion="Descargá Zonda para Windows, macOS o Linux."
>
	<section class="contenedor encabezado-seccion">
		<h2>Instaladores listos para usar</h2>
		<p>Bajá el instalador de tu sistema operativo desde la <a href="https://github.com/efdiloreto/ZondaPro/releases/latest">última release</a>.</p>
		<table>
			<thead>
				<tr>
					<th>Plataforma</th>
					<th>Formato</th>
				</tr>
			</thead>
			<tbody>
				{
					instaladores.map((instalador) => (
						<tr>
							<td><img class="icono" src={instalador.icono.src} alt="" width="16" height="16" /> {instalador.sistema}</td>
							<td>{instalador.archivo}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</section>
</Base>

<style>
	.encabezado-seccion {
		padding-top: 40px;
	}

	.encabezado-seccion h1 {
		font-size: 34px;
		margin-bottom: 4px;
	}

	.seccion {
		margin-top: 40px;
		padding-top: 24px;
		border-top: 1px solid var(--borde);
	}

	.seccion h2 {
		font-size: 22px;
	}

	.icono {
		vertical-align: -3px;
		margin-right: 6px;
	}
</style>
