// El marco de una captura de pantalla. Mientras no haya imágenes
// locales, dibuja el lugar que van a ocupar: celeste de foco, borde
// fino y el texto que dice qué va ahí.

interface Props {
	titulo: string;
	imagen?: string;
}

const { titulo, imagen } = Astro.props;
---

<figure class="captura">
	{
		imagen ? (
			<img src={imagen} alt={titulo} loading="lazy" />
		) : (
			<div class="marcador" aria-hidden="true">
				<span>Captura pendiente</span>
				<span class="texto-suave">{titulo}</span>
			</div>
		)
	}
	<figcaption>{titulo}</figcaption>
</figure>

<style>
	.captura {
		margin: 0;
	}

	.captura img {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--borde);
		border-radius: 2px;
	}

	/* El lugar reservado: celeste suave como los campos con foco. */
	.marcador {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 4px;
		aspect-ratio: 16 / 9;
		background-color: var(--celeste);
		border: 1px dashed var(--linea);
		border-radius: 2px;
		font-family: var(--fuente-titulos);
		font-size: 15px;
	}

	figcaption {
		margin-top: 6px;
		font-size: 12px;
		color: var(--texto-suave);
		text-align: center;
	}
</style>
