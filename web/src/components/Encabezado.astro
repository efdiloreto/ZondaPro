// El encabezado viste como los paneles de la aplicación: fondo gris con
// la línea inferior que los cierra. Los enlaces se ven como los del pie
// de la ventana, y la página activa se marca con el celeste y la línea
// azul del índice del reporte.

import logo from '../assets/logo.png';

const enlaces = [
	{ ruta: '/', texto: 'Inicio' },
	{ ruta: '/caracteristicas/', texto: 'Características' },
	{ ruta: '/edificio/', texto: 'Edificio' },
	{ ruta: '/cartel/', texto: 'Cartel' },
	{ ruta: '/cubierta-aislada/', texto: 'Cubierta aislada' },
	{ ruta: '/descarga/', texto: 'Descarga' },
	{ ruta: '/acerca/', texto: 'Acerca de' },
];

const rutaActual = Astro.url.pathname;

// El base no termina en barra y las rutas vienen con la inicial: se
// concatenan directo para que respeten /ZondaPro/.
const rutaDe = (ruta: string) => `${import.meta.env.BASE_URL}${ruta}`;

const estaActiva = (ruta: string) =>
	ruta === '/' ? rutaActual === rutaDe('/') : rutaActual.startsWith(rutaDe(ruta));
---

<header class="encabezado">
	<div class="contenedor fila">
		<a class="logo" href={rutaDe('/')}>
			<img src={logo.src} width="112" height="37" alt="Zonda" />
		</a>
		<nav aria-label="Navegación principal">
			{
				enlaces.map((enlace) => (
					<a class:list={['enlace', { activo: estaActiva(enlace.ruta) }]} href={rutaDe(enlace.ruta)}>
						{enlace.texto}
					</a>
				))
			}
		</nav>
	</div>
</header>

<style>
	.encabezado {
		background-color: var(--fondo-panel);
		border-bottom: 1px solid var(--linea);
	}

	.fila {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
		padding-top: 10px;
		padding-bottom: 10px;
	}

	.logo {
		display: inline-flex;
	}

	.logo:hover {
		text-decoration: none;
	}

	nav {
		display: flex;
		gap: 4px;
		flex-wrap: wrap;
	}

	/* Los enlaces del pie de la ventana: azules, subrayados al pasar. */
	.enlace {
		font-family: var(--fuente-titulos);
		font-size: 15px;
		color: var(--azul);
		padding: 4px 10px;
		border-radius: 3px;
	}

	.enlace:hover {
		color: var(--azul-hover);
		background-color: var(--pildora-hover);
		text-decoration: none;
	}

	/* La página visible: celeste de selección y línea azul, como el
	   índice del reporte marca la sección corriente. */
	.enlace.activo {
		color: var(--texto);
		background-color: var(--celeste);
		box-shadow: inset 0 -3px 0 var(--azul);
	}
</style>
