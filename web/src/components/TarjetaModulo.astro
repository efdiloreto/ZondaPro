// La tarjeta de módulo de la bienvenida: ícono arriba y título en
// Oswald, sobre el borde fino de las subsecciones del reporte.

interface Props {
	titulo: string;
	icono: string;
}

const { titulo, icono } = Astro.props;
---

<article class="tarjeta modulo">
	<img src={icono} width="72" height="72" alt="" />
	<h3>{titulo}</h3>
</article>

<style>
	.modulo {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		padding: 24px 20px;
		text-align: center;
	}

	.modulo h3 {
		font-size: 18px;
		font-weight: 500;
		margin: 0;
	}
</style>
