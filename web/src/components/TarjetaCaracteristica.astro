// La tarjeta chica de característica del home: título en Oswald y una
// línea de texto debajo, sobre la tarjeta de borde fino de la interfaz.

interface Props {
	titulo: string;
	texto: string;
}

const { titulo, texto } = Astro.props;
---

<article class="tarjeta caracteristica">
	<h3>{titulo}</h3>
	<p>{texto}</p>
</article>

<style>
	.caracteristica {
		padding: 16px 18px;
	}

	.caracteristica h3 {
		font-size: 16px;
		margin-bottom: 4px;
	}

	.caracteristica p {
		margin: 0;
		font-size: 14px;
		color: var(--texto-suave);
	}
</style>
