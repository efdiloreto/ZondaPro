<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copyright (c) 2018-2026, Eduardo Di Loreto <efdiloreto@gmail.com>
  This file is part of Zonda (GPLv3).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Package Name="Zonda"
             Language="1033"
             Version="$(var.Version)"
             Manufacturer="Eduardo Di Loreto"
             UpgradeCode="A2B3C4D5-E6F7-48A9-B1C2-D3E4F5A6B7C8"
             Scope="perMachine"
             Compressed="yes">

        <SummaryInformation Description="Instalador de Zonda - Cargas de viento CIRSOC 102-2025" />

        <!--
          AllowSameVersionUpgrades evita que reinstalar un build de la misma
          version quede como una segunda instalacion en paralelo: sin esto, la
          version exacta no cae ni en el rango de upgrade ni en el de downgrade.
        -->
        <MajorUpgrade AllowSameVersionUpgrades="yes"
                      DowngradeErrorMessage="Una version mas reciente de Zonda ya esta instalada." />
        <MediaTemplate EmbedCab="yes" />

        <!-- Icono de la aplicacion -->
        <Icon Id="ZondaIcon.ico" SourceFile="$(var.SourceDir)\zonda.ico" />
        <Property Id="ARPPRODUCTICON" Value="ZondaIcon.ico" />
        <Property Id="ARPHELPLINK" Value="https://github.com/efdiloreto/ZondaPro" />

        <!-- Estructura de Directorios -->
        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="INSTALLFOLDER" Name="Zonda" />
        </StandardDirectory>
        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="ApplicationProgramsFolder" Name="Zonda" />
        </StandardDirectory>
        <StandardDirectory Id="DesktopFolder" />

        <!-- Componente Principal: Zonda.exe y Accesos Directos -->
        <Component Id="ZondaExecutable"
                   Directory="INSTALLFOLDER"
                   Guid="B1C2D3E4-F5A6-47B8-C9D0-E1F2A3B4C5D6"
                   Bitness="always64">
            <File Id="ZondaExe"
                  Source="$(var.SourceDir)\Zonda.exe"
                  KeyPath="yes">
                <!-- Acceso directo en Menu Inicio -->
                <Shortcut Id="ApplicationStartMenuShortcut"
                          Directory="ApplicationProgramsFolder"
                          Name="Zonda"
                          Description="Calculo de cargas de viento segun CIRSOC 102-2025"
                          WorkingDirectory="INSTALLFOLDER"
                          Icon="ZondaIcon.ico"
                          Advertise="yes" />
                <!-- Acceso directo en Escritorio -->
                <Shortcut Id="ApplicationDesktopShortcut"
                          Directory="DesktopFolder"
                          Name="Zonda"
                          Description="Calculo de cargas de viento segun CIRSOC 102-2025"
                          WorkingDirectory="INSTALLFOLDER"
                          Icon="ZondaIcon.ico"
                          Advertise="yes" />
            </File>

            <!-- Registro de extension .zda -->
            <ProgId Id="Zonda.Project.1" Description="Archivo de Proyecto Zonda" Icon="ZondaExe" IconIndex="0">
                <Extension Id="zda" ContentType="application/x-zonda">
                    <Verb Id="open" Command="Abrir con Zonda" TargetFile="ZondaExe" Argument="&quot;%1&quot;" />
                </Extension>
            </ProgId>
        </Component>

        <!-- Limpieza de la carpeta de accesos directos del Menu Inicio -->
        <Component Id="ApplicationShortcut"
                   Directory="ApplicationProgramsFolder"
                   Guid="C2D3E4F5-A6B7-48C9-D0E1-F2A3B4C5D6E7">
            <RemoveFolder Id="CleanUpShortCut" On="uninstall" />
            <RegistryValue Root="HKMU" Key="Software\EduardoDiLoreto\Zonda" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>

        <!--
          El resto del bundle se recolecta automaticamente desde dist/bundle. Se
          listan las carpetas una por una en vez de usar un unico comodin en la
          raiz porque Zonda.exe tiene que quedar afuera: ya viaja en el componente
          ZondaExecutable, que es el que cuelga los accesos directos.
          Subdirectory conserva el prefijo de cada carpeta en la instalacion; sin
          el, Files aplana todo contra INSTALLFOLDER y el lanzador no encuentra
          ni python/ ni app/.
        -->
        <ComponentGroup Id="BundleComponents" Directory="INSTALLFOLDER">
            <Files Include="$(var.SourceDir)\app\**" Subdirectory="app" />
            <Files Include="$(var.SourceDir)\python\**" Subdirectory="python" />
            <Files Include="$(var.SourceDir)\tools\**" Subdirectory="tools" />
            <Files Include="$(var.SourceDir)\zonda.ico" />
        </ComponentGroup>

        <!-- Caracteristicas (Features) a instalar -->
        <Feature Id="ProductFeature" Title="Zonda" Level="1">
            <ComponentRef Id="ZondaExecutable" />
            <ComponentRef Id="ApplicationShortcut" />
            <ComponentGroupRef Id="BundleComponents" />
        </Feature>
    </Package>
</Wix>
