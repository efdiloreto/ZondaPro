        </screenshot>
        <screenshot>
            <caption>Visor y exportación de reportes</caption>
            <image>https://imgur.com/DOw0StA.png</image>
        </screenshot>
    </screenshots>

    <content_rating type="oars-1.1"/>

    <releases>
        <release version="1.0.0" date="2026-08-26">
            <description>
                <p>Primera versión pública: cálculo de viento según CIRSOC 102-2005.</p>
            </description>
        </release>
    </releases>
</component>
