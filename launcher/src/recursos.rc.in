/*
 * Plantilla: launcher/build.py la completa y escribe recursos.generado.rc, que
 * es lo que se compila. Los marcadores salen de __version__ en
 * python/zonda/__acercade__.py, para que la version que muestran las
 * propiedades del ejecutable no se quede vieja.
 */

#include <windows.h>

// Icono principal de la aplicacion
1 ICON "zonda.ico"

// Informacion de version
VS_VERSION_INFO VERSIONINFO
FILEVERSION     @VERSION_COMA@
PRODUCTVERSION  @VERSION_COMA@
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Eduardo Di Loreto\0"
            VALUE "FileDescription",  "Zonda - Cargas de viento CIRSOC 102-2025\0"
            VALUE "FileVersion",      "@VERSION_PUNTO@\0"
            VALUE "InternalName",     "Zonda\0"
            VALUE "LegalCopyright",   "Copyright (c) 2018-2026 Eduardo Di Loreto (GPLv3)\0"
            VALUE "OriginalFilename", "Zonda.exe\0"
            VALUE "ProductName",      "Zonda\0"
            VALUE "ProductVersion",   "@VERSION_PUNTO@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
